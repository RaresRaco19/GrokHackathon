{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|search_replace|write|Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 python/protect_rules.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
