{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GROK_WORKSPACE_ROOT/.grok/hooks/scripts/enforce_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GROK_WORKSPACE_ROOT/.grok/hooks/scripts/enforce_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GROK_WORKSPACE_ROOT/.grok/hooks/scripts/enforce_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write|Write|Edit|search_replace|Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GROK_WORKSPACE_ROOT/.grok/hooks/scripts/enforce_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GROK_WORKSPACE_ROOT/.grok/hooks/scripts/enforce_rules.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
